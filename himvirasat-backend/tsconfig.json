{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "noImplicitAny": true,

    "noUnusedLocals": true,

    "noUnusedParameters": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true
  },

  "include": ["src"]
}
